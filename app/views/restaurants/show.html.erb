<h1>Detail du resto</h1>

<h3><%= @restaurant.name %></h3>
<p>catégorie : <%= @restaurant.category %></p>
<p>téléphone : <%= @restaurant.phone_number %></p>
<p>ville : <%= @restaurant.address %></p>

<h2>Reviews :</h2>
<div><%= simple_form_for [@restaurant, @review] do |f| %>
  <%= f.input :content %>
  <%= f.input :rating %>
  <%= f.submit %>
<% end %>
</div>
<div>
  <% @restaurant.reviews.each do |review| %>
  <p>Notes : <%= review.rating %> / 5</p>
  <p><%= review.content %></p>
  <p>----------------</p>
  <% end %>
</div>
